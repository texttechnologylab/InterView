# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- MongoDB (external) ------------------------------------------------------
DB_SERVER=mongo.example.org
DB_PORT=27017
DB_NAME=Lab2
DB_USERNAME=<mongo user>
DB_PASSWORD=

# Shared secret for the logging API. Clients send it as the X-API-KEY header;
# the Unity client must be configured with the same value.
X_API_KEY=

# --- Host ports --------------------------------------------------------------
# Janus and coturn use host networking and take their ports from their own
# config files, not from here.
UBIQ_TCP_PORT=16485
UBIQ_STATUS_PORT=16486
DATABASE_API_PORT=16481
WEBSITE_PORT=18800

# Janus gateway image tag - see github.com/texttechnologylab/Janus-Gateway
JANUS_TAG=1.4.2

# --- Storage -----------------------------------------------------------------
# Where Janus writes .mjr recordings. Needs real capacity: a single interview
# produces separate audio and video tracks per participant.
RECORDINGS_DIR=./data/recordings
